{
  "name": "ephe-frontend",
  "version": "0.2.1",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/stamp-sw-version.mjs",
    "preview": "vite preview",
    "bundle:audit": "python3 scripts/bundle_audit.py dist",
    "bundle:budget": "python3 scripts/bundle_budget.py dist",
    "lint": "eslint .",
    "verify:pre-push": "pnpm run lint && node ../scripts/architecture_check.mjs check --changed",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:e2e": "playwright test -c tests/playwright/playwright.config.ts",
    "test:e2e:real": "playwright test -c tests/playwright/playwright.real.config.ts",
    "test:dogfood": "playwright test -c tests/playwright/dogfood.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.19",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.5.0",
    "i18next": "^26.4.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb": "^8.0.4",
    "katex": "^0.19.0",
    "lucide-react": "^1.60.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.0.1",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.6.1",
    "axe-core": "4.14.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
