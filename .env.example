# Ephe — Environment Variables
# Copy to .env and fill in. NEVER commit real values.
#
# The engine is YOURS to choose — there is no silent default. Configure it either
#   a) interactively:  ephe configure    (saved to ~/.ephe/engine.json)
#   b) via this env:   EPHE_MODEL_PROVIDER + the matching endpoint/model below
# Without (a) or (b) nothing picks an engine in silence: on loopback the server
# starts in SETUP MODE and the app asks for the choice (chat stays closed until
# then), while a LAN start (--lan, --host 0.0.0.0, EPHE_LAN=1, EPHE_HOST=0.0.0.0)
# refuses and prints the fix. Measured 2026-10-10: run_server.py:124-129,
# server/routes/chat.py:601-613. `ephe start` is the one path that does not hold
# to this yet — see docs/UNBACKED_CLAIMS_2026-10-10.md.
#
# Praefix note: EPHE_* is the only prefix this project reads. The pre-rename
# fallback was removed (pinned by tests/test_env_dual_read.py);
# setting an old-prefixed variable has no effect.

# --- Engine / Model Selection (SSOT: core/engine_config.py) ---
# Provider: local_ollama | custom_ollama | openai_compatible
#EPHE_MODEL_PROVIDER=local_ollama

# --- CORS: origins the browser may call this server from, cross-origin ---
# The product needs none: the PWA is served by this server (same origin) and the dev server
# proxies /api to it. Name an origin here only for a front end that talks to this server from
# a different origin (a dev server run without the proxy, a second machine's browser).
#EPHE_DEV_ORIGINS=http://localhost:5173

# --- Option 1: local Ollama (EPHE_MODEL_PROVIDER=local_ollama) ---
# The tag that exists in your local Ollama — `ollama list` prints them. There is no
# default: unset or empty, Ephe refuses and names this variable instead of choosing a
# model for you, so the line stays commented in the template rather than carrying a tag.
#EPHE_MODEL=your-model-id
# Ollama base URL (optional; default http://127.0.0.1:11434)
#EPHE_LOCAL_OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Option 2: remote Ollama / vLLM with the Ollama API (EPHE_MODEL_PROVIDER=custom_ollama) ---
#EPHE_CUSTOM_OLLAMA_BASE_URL=http://192.168.1.50:11434

# --- Option 3: OpenAI-compatible endpoint — DGX Spark / vLLM / SGLang / cloud ---
# Recommended preset for a DGX Spark or any vLLM/SGLang server
# (EPHE_MODEL_PROVIDER=openai_compatible). Replace host/port/model with your own
# values — no host and no key are hardcoded anywhere in the code.
#EPHE_OPENAI_COMPAT_BASE_URL=http://your-engine-host:8000/v1
#EPHE_OPENAI_COMPAT_MODEL=your-model-id
# Optional bearer token, only if your engine requires one. Never written to
# ~/.ephe/engine.json.
#EPHE_OPENAI_COMPAT_API_KEY=

# --- Server (EPHE_* only) ---
# Host and port for the FastAPI backend
EPHE_HOST=127.0.0.1
EPHE_PORT=8765
# 1 = bind to LAN (0.0.0.0); keep 0 for loopback-only
EPHE_LAN=0

# --- Optional overrides ---
#EPHE_CONFIG_DIR=~/.ephe
#EPHE_WORKSPACE=
#EPHE_OUTPUT_DIR=

# --- Code execution runtime (SSOT: core/cpython_cell.py) ---
# Default: the pinned CPython guest inside Ephemora Cell (fuel / memory / disk /
# no network). Requires the opt-in extra and the built guest:
#   pip install 'ephe[sandbox]'   &&   python3 build_cpython_guest.py
# `kernel` is the explicit opt-OUT: model Python then runs inside the Ephe
# process with FULL host access (os, subprocess, your files, your network).
# Every result says so, and the agent panel labels the card "kernel · unsandboxed".
# Unset or empty means the cell when the guest verifies, else the kernel — and the
# runtime is always named, never hidden. An unknown value refuses to run anything.
#EPHE_CODE_EXEC=cpython-cell
#EPHE_CODE_EXEC=kernel
# Fuel ceiling per run (an engine unit, not seconds: ~9 G per guest CPU-second,
# so the 20 G default is ~2,2 s of number-crunching). Raising it raises the blast
# radius of generated code; the wall-clock ceiling stays timeout_seconds.
#EPHE_CELL_MAX_FUEL=20000000000

# --- fetch_url reach (core/net_guard.py) ---
# Off-by-default: the fetch tool reads public http/https only. Link-local and
# cloud-metadata targets stay blocked either way. Set this only when you want
# the agent to read a dev server on your own machine.
#EPHE_FETCH_ALLOW_PRIVATE=1

# --- Preview proxy reach (server/routes/proxy.py) ---
# /api/proxy serves the preview panel and speaks loopback only, ports 1024..65535.
# Named local services stay closed because their answer is data, not a page:
# Docker 2375/2376/4243, Postgres 5432, MySQL 3306, MSSQL 1433, Redis 6379,
# Memcached 11211, MongoDB 27017, Elasticsearch 9200/9300, CouchDB 5984, etcd
# 2379/2380, Kubelet 10250/10255, Ollama 11434. List a port here to preview it
# anyway — an explicit widening, never a loosened default (privileged ports under
# 1024 stay refused either way).
#EPHE_PROXY_PORTS=6379
