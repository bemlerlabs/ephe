# EditorConfig — consistent baselines across editors (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Trailing double-spaces are intentional Markdown hard breaks
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 4

[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab
