# Normalize line endings
* text=auto

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Shell scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Markdown
*.md text

# Config
*.yaml text
*.yml text
*.toml text
*.json text
*.html text
*.css text
*.ts text
*.tsx text
*.py text
# npm diff-noise on Windows contributors: keep eol as committed
package-lock.json -text
