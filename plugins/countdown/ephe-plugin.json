{
  "manifest_version": 2,
  "name": "countdown",
  "version": "0.1.0",
  "description": "A countdown widget: one declarative surface the shell can show, and a timer the agent can set and read back.",
  "publisher": {
    "name": "Ephe"
  },
  "license": "MIT",
  "origin": "first-party",
  "icon": "icon.svg",
  "engines": {
    "ephe": ">=0.5.7"
  },
  "permissions": {
    "tool_families": [],
    "data_roots": ["countdown"]
  },
  "components": {
    "ui": {
      "type": "floating-window",
      "entry": "ui/index.html",
      "title": "Countdown",
      "default_size": {
        "width": 260,
        "height": 132
      },
      "transparent": true,
      "always_on_top": true,
      "capabilities": ["notifications", "dock-badge", "audio-out"]
    },
    "tools": []
  },
  "changelog": "0.1.0 - the walking skeleton: one Manifest v2 surface, one timer tool on the connector's rail, one declared data root."
}
